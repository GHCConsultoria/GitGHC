{
  "name": "gitghc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "sh -c 'if [ -n \"$DIRECT_URL\" ]; then npx prisma migrate deploy && npx prisma db seed; fi' && sh -c 'if [ -n \"$TURSO_DATABASE_URL\" ]; then (node prisma/nutri/aplicar-schema.mjs && npx tsx prisma/nutri/seed.ts) || echo \"[nosheipe] setup do Turso falhou (credencial expirada/rotacionada?) -- build do sistema juridico segue mesmo assim, NoSheipe e um produto separado\"; fi' && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "postinstall": "prisma generate && prisma generate --schema=prisma/nutri/schema.prisma",
    "db:push:nutri": "node prisma/nutri/aplicar-schema.mjs",
    "db:seed:nutri": "tsx prisma/nutri/seed.ts",
    "prepare": "husky",
    "biome:check": "biome check .",
    "biome:check:changed": "biome check --changed --no-errors-on-unmatched",
    "format": "biome format --write .",
    "knip": "knip",
    "arch:check": "depcruise src --config .dependency-cruiser.cjs",
    "test:e2e": "playwright test",
    "quality": "npm run lint && npm run biome:check && npm run knip && npm run arch:check && npm run test"
  },
  "dependencies": {
    "@libsql/client": "^0.8.1",
    "@prisma/adapter-libsql": "^5.22.0",
    "@prisma/client": "5.22.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "4.1.10",
    "dependency-cruiser": "18.2.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "husky": "9.1.7",
    "knip": "6.32.1",
    "postcss": "^8",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
