generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (pgbouncer, porta 6543) — usada pela aplicação em runtime.
  url       = env("DATABASE_URL")
  // Direta (porta 5432) — só para migrations/DDL, que não funcionam bem
  // atrás de um pooler em modo transaction. Usada por `prisma migrate deploy`.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Tenant
// ---------------------------------------------------------------------------

model Escritorio {
  id    String @id @default(cuid())
  nome  String
  oab   String
  uf    String

  // Token do link secreto do feed ICS (calendário) — null até a primeira
  // vez que a tela /escritorio precisa dele (gerado sob demanda, não na
  // criação do escritório). Regenerável para revogar um link vazado.
  calendarioFeedToken String? @unique

  usuarios   Usuario[]
  processos  Processo[]

  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("escritorios")
}

enum RoleUsuario {
  ADVOGADO
  ASSISTENTE
}

model Usuario {
  id           String      @id @default(cuid())
  // id do usuário no Supabase Auth (auth.users.id)
  authUserId   String      @unique
  nome         String
  email        String
  role         RoleUsuario
  // Formato internacional (ex.: +5511999999999). Null = usuário não optou
  // por alertas via WhatsApp, continua recebendo só por e-mail.
  telefoneWhatsapp String?

  escritorio   Escritorio  @relation(fields: [escritorioId], references: [id])
  escritorioId String

  prazosConfirmados Prazo[]         @relation("PrazoConfirmadoPor")
  logsAuditoria     LogAuditoria[]
  rascunhosPeticaoGerados RascunhoPeticao[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("usuarios")
}

// ---------------------------------------------------------------------------
// Processo
// ---------------------------------------------------------------------------

enum ParteRepresentada {
  AUTOR
  REU
  TERCEIRO
}

model Processo {
  id          String @id @default(cuid())
  // apenas dígitos, sem máscara
  numeroCnj   String
  cliente     String
  varaOrgao   String
  uf          String
  tribunal    String

  prazoEmDobro       Boolean           @default(false)
  parteRepresentada  ParteRepresentada

  escritorio   Escritorio @relation(fields: [escritorioId], references: [id])
  escritorioId String

  publicacoes Publicacao[]
  prazos      Prazo[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // numeroCnj é único por escritório, não globalmente
  @@unique([escritorioId, numeroCnj])
  @@map("processos")
}

// ---------------------------------------------------------------------------
// Publicacao
// ---------------------------------------------------------------------------

enum StatusPublicacao {
  NAO_IDENTIFICADA
  VINCULADA
  DESCARTADA
}

model Publicacao {
  id                  String   @id @default(cuid())
  conteudo             String
  dataDisponibilizacao DateTime
  dataPublicacao       DateTime?
  fonte                String
  // hash sha256 do conteúdo bruto + identificador da fonte — garante idempotência
  hashConteudo         String   @unique
  status               StatusPublicacao @default(NAO_IDENTIFICADA)
  rawJson              Json

  processo   Processo? @relation(fields: [processoId], references: [id])
  processoId String?

  prazos     Prazo[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("publicacoes")
}

// ---------------------------------------------------------------------------
// Prazo
// ---------------------------------------------------------------------------

enum StatusPrazo {
  PENDENTE_CONFIRMACAO
  CONFIRMADO
  CUMPRIDO
  DESCARTADO
}

model Prazo {
  id  String @id @default(cuid())

  publicacao   Publicacao @relation(fields: [publicacaoId], references: [id])
  publicacaoId String

  processo   Processo @relation(fields: [processoId], references: [id])
  processoId String

  tipoAto             String
  descricao            String
  dataInicioContagem   DateTime
  diasPrazo            Int
  contagemDiasUteis    Boolean
  dataFatal            DateTime
  // Passo a passo produzido pelo motor de cálculo (Fase 3) no momento em que
  // este Prazo foi criado — é o que a tela de confirmação mostra em "como
  // foi calculada" para gerar confiança no valor proposto.
  detalhesCalculo      Json?

  status       StatusPrazo @default(PENDENTE_CONFIRMACAO)

  confirmadoPor   Usuario? @relation("PrazoConfirmadoPor", fields: [confirmadoPorId], references: [id])
  confirmadoPorId String?
  confirmadoEm    DateTime?

  alertasEnviados AlertaPrazoEnviado[]
  rascunhosPeticao RascunhoPeticao[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("prazos")
}

// ---------------------------------------------------------------------------
// Auditoria
// ---------------------------------------------------------------------------

model LogAuditoria {
  id         String   @id @default(cuid())

  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioId  String

  entidade     String
  entidadeId   String
  acao         String
  valorAnterior Json?
  valorNovo     Json?

  criadoEm   DateTime @default(now())

  @@index([entidade, entidadeId])
  @@map("logs_auditoria")
}

// ---------------------------------------------------------------------------
// Feriados forenses
// ---------------------------------------------------------------------------

enum TipoFeriado {
  FERIADO
  SUSPENSAO
  RECESSO
}

model FeriadoForense {
  id        String   @id @default(cuid())
  uf        String
  // null = feriado nacional, aplica a todos os tribunais da UF
  tribunal  String?
  data      DateTime
  descricao String
  tipo      TipoFeriado

  @@unique([uf, tribunal, data])
  @@map("feriados_forenses")
}

// ---------------------------------------------------------------------------
// Motor de prazo (Fase 3)
// ---------------------------------------------------------------------------

// Mapeamento tipoAto -> diasPrazo, configurável e fora do meio da lógica de
// cálculo. Se um tipoAto não estiver aqui, o motor manda para revisão manual
// em vez de chutar um valor.
model TipoAtoPrazo {
  id                String  @id @default(cuid())
  tipoAto           String  @unique
  diasPrazo         Int
  contagemDiasUteis Boolean @default(true)
  descricao         String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("tipos_ato_prazo")
}

// Controle de revisão do calendário forense por UF/ano. Existe para
// distinguir "esta UF não tem feriado estadual cadastrado neste ano" de
// "ainda não cadastramos os feriados desta UF" — sem isso as duas situações
// são indistinguíveis e o motor arriscaria calcular um prazo com calendário
// incompleto. Enquanto uma UF/ano não estiver marcado como revisado aqui, o
// motor de prazo recusa calcular e manda para revisão manual com o alerta
// FERIADOS_NAO_REVISADOS.
model RevisaoFeriadosUf {
  id       String  @id @default(cuid())
  uf       String
  ano      Int
  revisado Boolean @default(false)

  @@unique([uf, ano])
  @@map("revisoes_feriados_uf")
}

// ---------------------------------------------------------------------------
// Automação diária e alertas (Fase 5)
// ---------------------------------------------------------------------------

// Registro de cada execução do cron diário — é o que alimenta o painel de
// saúde ("última execução, quantas publicações ingeridas..."). Uma linha por
// execução, nunca sobrescrita.
model ExecucaoCron {
  id  String @id @default(cuid())

  executadoEm                 DateTime @default(now())
  publicacoesEncontradas      Int
  publicacoesNovas            Int
  publicacoesNaoIdentificadas Int
  prazosCriados               Int
  prazosParaRevisaoManual     Int
  sucesso                     Boolean
  erro                        String?

  @@map("execucoes_cron")
}

enum TipoAlertaPrazo {
  D5
  D2
  D1
}

// Dedup de alertas de vencimento (D-5/D-2/D-1) por prazo: sem isso, cada
// execução diária do cron reenviaria o mesmo aviso enquanto o prazo
// permanecer nessa faixa. O alerta de "prazos novos pendentes" não precisa
// de dedup aqui porque só é dado no exato momento em que o Prazo é criado
// (evento único, não recorrente).
model AlertaPrazoEnviado {
  id  String @id @default(cuid())

  prazo   Prazo           @relation(fields: [prazoId], references: [id])
  prazoId String
  tipo    TipoAlertaPrazo

  enviadoEm DateTime @default(now())

  @@unique([prazoId, tipo])
  @@map("alertas_prazo_enviados")
}

// ---------------------------------------------------------------------------
// Rascunho de petição com IA
// ---------------------------------------------------------------------------

// Rascunho gerado por IA a partir de um prazo CONFIRMADO — sempre um
// ponto de partida pra revisão humana, nunca protocolado ou enviado
// automaticamente por este sistema. Guardamos o histórico (não sobrescreve)
// pra poder comparar gerações e saber quem pediu e quando.
model RascunhoPeticao {
  id  String @id @default(cuid())

  prazo   Prazo  @relation(fields: [prazoId], references: [id])
  prazoId String

  conteudo String
  modelo   String

  criadoPor   Usuario @relation(fields: [criadoPorId], references: [id])
  criadoPorId String

  criadoEm DateTime @default(now())

  @@map("rascunhos_peticao")
}

// ---------------------------------------------------------------------------
// Módulo nutrição — MVP "Trilha A" (demo separado, mesmo projeto Supabase/DB
// por conveniência de ambiente, sem nenhuma relação com os models acima).
// Nutricionista.authUserId aponta pro mesmo auth.users do Supabase Auth do
// sistema jurídico, mas neste MVP um authUserId nunca tem linha em Usuario e
// em Nutricionista ao mesmo tempo.
// ---------------------------------------------------------------------------

model Nutricionista {
  id  String @id @default(cuid())

  authUserId  String @unique
  nome        String
  email       String @unique
  crn         String?
  // Limite do plano demo (R$ 99,90) — sem gateway de pagamento neste MVP,
  // só a trava de quantidade em criarPaciente.
  limitePlano Int    @default(20)

  pacientes Paciente[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("nutricionistas")
}

enum StatusPaciente {
  ATIVO
  ARQUIVADO
}

model Paciente {
  id  String @id @default(cuid())

  nutricionista   Nutricionista @relation(fields: [nutricionistaId], references: [id])
  nutricionistaId String

  nome     String
  telefone String?

  // Token opaco do link público (/p/[token]) — acesso do paciente sem senha.
  tokenAcesso String @unique

  metaKcal     Int
  metaProteina Int
  metaCarbo    Int
  metaGordura  Int

  // LGPD: null até o paciente aceitar o consentimento na primeira visita à
  // própria página — sem isso o registro de refeição não libera.
  consentimentoEm DateTime?

  status StatusPaciente @default(ATIVO)

  registros RegistroRefeicao[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("pacientes")
}

enum OrigemRegistro {
  AUDIO
  TEXTO
}

model RegistroRefeicao {
  id  String @id @default(cuid())

  paciente   Paciente @relation(fields: [pacienteId], references: [id])
  pacienteId String

  // UUID gerado pelo client — dedupe idempotente (reprocessar o mesmo envio
  // nunca duplica o registro).
  clienteRegistroId String @unique

  origem       OrigemRegistro
  entradaBruta String // texto digitado ou transcrição do áudio
  itens        Json   // [{ nome, gramas, kcal, proteina, carbo, gordura }]

  kcal      Int
  proteina  Int
  carbo     Int
  gordura   Int
  // 0..1 devolvido pela IA — é estimativa, nunca fato; rotulado como tal na UI.
  confianca Float

  registradoEm DateTime @default(now())
  criadoEm     DateTime @default(now())

  @@map("registros_refeicao")
}
