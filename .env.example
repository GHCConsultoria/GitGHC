# PostgreSQL (Supabase). Dois valores porque o Supabase usa um pooler
# (pgbouncer) para conexões da aplicação, mas migrations/DDL precisam de
# conexão direta:
# - DATABASE_URL: Settings > Database > Connection string > "Transaction" (porta 6543)
# - DIRECT_URL: Settings > Database > Connection string > "Session"/direct (porta 5432)
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Usada em src/lib/supabase/admin.ts para criar usuário (tela /usuarios).
# Nunca expor no cliente — só em código server-side. Segredo de acesso
# total, ignora RLS; trate como senha de root do banco.
SUPABASE_SERVICE_ROLE_KEY=""

# Cron da Vercel (ver vercel.json): protege /api/cron/diario. A Vercel manda
# esse valor sozinha no header Authorization quando configurado nas env vars
# do projeto — não precisa setar manualmente em produção além de cadastrar lá.
CRON_SECRET=""

# E-mail dos alertas (Resend — https://resend.com). Sem isso, os alertas só
# são logados no console (ver src/lib/alertas/email.ts), a rotina não falha.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Alerta por WhatsApp (Meta Cloud API), opcional e por usuário — cada
# usuário define o próprio número em /usuarios. Sem essas variáveis, os
# alertas de WhatsApp só são logados no console (ver src/lib/alertas/
# whatsapp.ts), a rotina não falha. Setup necessário na Meta:
# 1. Criar conta de desenvolvedor em https://developers.facebook.com e um
#    app com o produto "WhatsApp" (dá um número de teste grátis, até 5
#    destinatários, sem verificação de empresa).
# 2. Criar e submeter pra aprovação um template de mensagem com UM
#    parâmetro de corpo (ex.: "Você tem {{1}} prazo(s) novo(s) aguardando
#    confirmação no GitGHC.") — a Meta exige template pra qualquer
#    mensagem iniciada pelo negócio, não dá pra mandar texto livre.
# 3. Preencher as variáveis abaixo com o token, o phone_number_id e o nome
#    do template aprovado (o padrão abaixo é só um nome sugerido).
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME="alerta_prazo"
WHATSAPP_TEMPLATE_IDIOMA="pt_BR"

# Rascunho de petição com IA (Anthropic — https://console.anthropic.com).
# Sem ANTHROPIC_API_KEY, o botão "Gerar rascunho com IA" retorna um erro
# claro em vez de fingir uma resposta (ver src/lib/ia/anthropic.ts). O mesmo
# ANTHROPIC_API_KEY é reaproveitado pela extração de macros do NoSheipe
# (ver src/lib/nutri/ia.ts) — não precisa de uma chave separada.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Banco do módulo NoSheipe (Turso/libSQL) — separado do Postgres/Supabase
# acima, schema próprio em prisma/nutri/schema.prisma (ver src/lib/nutri/
# prisma.ts). Criar com a Turso CLI:
#   turso db create nosheipe
#   turso db show nosheipe --url          -> TURSO_DATABASE_URL
#   turso db tokens create nosheipe        -> TURSO_AUTH_TOKEN
# Depois: npm run db:push:nutri && npm run db:seed:nutri
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
